<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Cadastro de Clientes</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f2f4f7;
      padding: 30px;
    }

    .container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    h1 {
      text-align: center;
      color: #333;
      margin-bottom: 25px;
    }

    h3 {
      margin: 25px 0 15px;
      color: #444;
    }

    .formulario {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    input {
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 16px;
      outline: none;
    }

    input:focus {
      border-color: #007bff;
    }

    .botoes {
      display: flex;
      gap: 10px;
    }

    button {
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
      color: white;
    }

    #btnSalvar {
      background: #007bff;
      flex: 1;
    }

    #btnCancelar {
      background: #6c757d;
      flex: 1;
      display: none;
    }

    ul {
      list-style: none;
    }

    li {
      background: #f8f9fa;
      margin-bottom: 10px;
      padding: 15px;
      border-radius: 8px;
      border-left: 4px solid #007bff;

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .dados-cliente {
      flex: 1;
    }

    .dados-cliente strong {
      color: #222;
    }

    .dados-cliente small {
      display: block;
      color: #666;
      margin-top: 4px;
    }

    .acoes {
      display: flex;
      gap: 5px;
    }

    .editar {
      background: #ffc107;
      color: #222;
    }

    .excluir {
      background: #dc3545;
    }

    .vazio {
      text-align: center;
      color: #777;
      padding: 15px;
    }
  </style>
</head>

<body>

  <div class="container">

    <h1>Cadastro de Clientes</h1>

    <div class="formulario">

      <input
        type="text"
        id="nome"
        placeholder="Nome do cliente"
      >

      <input
        type="text"
        id="endereco"
        placeholder="Endereço"
      >

      <input
        type="tel"
        id="telefone"
        placeholder="Telefone"
      >

      <div class="botoes">
        <button id="btnSalvar" onclick="salvarCliente()">
          Adicionar Cliente
        </button>

        <button id="btnCancelar" onclick="cancelarEdicao()">
          Cancelar
        </button>
      </div>

    </div>

    <h3>Lista de Clientes</h3>

    <ul id="listaClientes"></ul>

  </div>

  <script>

    // Guarda o índice do cliente que está sendo editado
    let clienteEditando = null;


    // Carrega os clientes salvos no localStorage
    function carregarClientes() {

      const clientes =
        JSON.parse(localStorage.getItem("clientes")) || [];

      const lista =
        document.getElementById("listaClientes");

      lista.innerHTML = "";


      // Verifica se não existem clientes
      if (clientes.length === 0) {

        lista.innerHTML =
          '<li class="vazio">Nenhum cliente cadastrado.</li>';

        return;
      }


      // Percorre todos os clientes
      clientes.forEach((cliente, index) => {

        const item = document.createElement("li");

        item.innerHTML = `
          <div class="dados-cliente">
            <strong>${cliente.nome}</strong>
            <small>📍 ${cliente.endereco}</small>
            <small>📞 ${cliente.telefone}</small>
          </div>

          <div class="acoes">
            <button
              class="editar"
              onclick="editarCliente(${index})">
              Editar
            </button>

            <button
              class="excluir"
              onclick="excluirCliente(${index})">
              Excluir
            </button>
          </div>
        `;

        lista.appendChild(item);
      });
    }


    // Salva um novo cliente ou atualiza um cliente existente
    function salvarCliente() {

      const nome =
        document.getElementById("nome").value.trim();

      const endereco =
        document.getElementById("endereco").value.trim();

      const telefone =
        document.getElementById("telefone").value.trim();


      // Verifica se os campos foram preenchidos
      if (!nome || !endereco || !telefone) {

        alert("Preencha todos os campos!");

        return;
      }


      const clientes =
        JSON.parse(localStorage.getItem("clientes")) || [];


      // Se estiver editando, atualiza o cliente
      if (clienteEditando !== null) {

        clientes[clienteEditando] = {
          nome,
          endereco,
          telefone
        };

        clienteEditando = null;

        document.getElementById("btnSalvar").textContent =
          "Adicionar Cliente";

        document.getElementById("btnCancelar").style.display =
          "none";

      }

      // Caso contrário, adiciona um novo cliente
      else {

        clientes.push({
          nome,
          endereco,
          telefone
        });
      }


      // Salva no localStorage
      localStorage.setItem(
        "clientes",
        JSON.stringify(clientes)
      );


      limparFormulario();

      carregarClientes();
    }


    // Exclui um cliente
    function excluirCliente(index) {

      const clientes =
        JSON.parse(localStorage.getItem("clientes")) || [];


      const confirmar =
        confirm("Deseja realmente excluir este cliente?");


      if (!confirmar) {
        return;
      }


      clientes.splice(index, 1);


      localStorage.setItem(
        "clientes",
        JSON.stringify(clientes)
      );


      carregarClientes();
    }


    // Coloca os dados do cliente no formulário para edição
    function editarCliente(index) {

      const clientes =
        JSON.parse(localStorage.getItem("clientes")) || [];

      const cliente = clientes[index];


      document.getElementById("nome").value =
        cliente.nome;

      document.getElementById("endereco").value =
        cliente.endereco;

      document.getElementById("telefone").value =
        cliente.telefone;


      // Guarda qual cliente está sendo editado
      clienteEditando = index;


      // Altera os botões
      document.getElementById("btnSalvar").textContent =
        "Salvar Alterações";

      document.getElementById("btnCancelar").style.display =
        "block";
    }


    // Cancela a edição
    function cancelarEdicao() {

      clienteEditando = null;

      limparFormulario();


      document.getElementById("btnSalvar").textContent =
        "Adicionar Cliente";

      document.getElementById("btnCancelar").style.display =
        "none";
    }


    // Limpa os campos do formulário
    function limparFormulario() {

      document.getElementById("nome").value = "";
      document.getElementById("endereco").value = "";
      document.getElementById("telefone").value = "";
    }


    // Carrega os clientes assim que a página abre
    carregarClientes();

  </script>

</body>
</html>
